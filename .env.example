# ---- Supabase (optional: without it, projects live in server memory + browser IndexedDB) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by API routes for Storage uploads / inserts (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=splats

# ---- Poly Pizza (optional: without it, the built-in procedural furniture library is used) ----
# Get a free key at https://poly.pizza/settings/api
POLY_PIZZA_API_KEY=

# ---- Reconstruction worker (optional: without it, /api/process runs in demo mode) ----
# A GPU worker (e.g. nerfstudio splatfacto / gsplat trainer) that accepts POST {jobId, images[]} and
# exposes GET {url}/jobs/{jobId} -> {status, progress, stage, splatUrl}
RECON_WORKER_URL=
RECON_WORKER_TOKEN=
NEXT_PUBLIC_SUPABASE_BUCKET=splats
